# Python / tooling caches
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.playwright-mcp/
*.pyc
*.pyo
*.pyd
.gitnexus

# Secrets and local env. Only .env.example is tracked.
# .dev.vars is wrangler's local secret file.
.env
.env.*
!.env.example
.dev.vars
apps/web/.dev.vars

# Node / Next.js / OpenNext build output
node_modules/
apps/web/.next/
apps/web/.next-dev/
apps/web/.open-next/
apps/web/.wrangler/
apps/web/out/
# Published copy of artifacts/previews (npm run prewarm:previews -w apps/web); the Web build ships it.
apps/web/public/previews/
# Regenerated by `next dev` / `next build`; Next.js recommends not committing it.
apps/web/next-env.d.ts
*.tsbuildinfo

# SQLite database and its sidecar files
data/competitions.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.ai.lock

# Runtime outputs (see AGENTS.md rule 6). Directories keep a .gitkeep.
# `dir/*` plus `!.gitkeep` is used because git cannot re-include a file
# when its parent directory itself is excluded.
data/geocoding-cache.json
data/inbox/*
!data/inbox/.gitkeep
data/eval/*
!data/eval/.gitkeep
reports/**
!reports/.gitkeep
artifacts/**
!artifacts/**/
!artifacts/**/.gitkeep
