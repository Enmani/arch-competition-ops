  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
