# Copy to .env and fill in what you need. Never commit real values (.env* is gitignored).
# Every variable below is read by code in this repository; unset means the default shown.
#
# Where each file is read from:
#   - Python worker: pydantic-settings reads .env in the working directory (repo root).
#   - Web app (Next.js): reads apps/web/.env*; wrangler secrets for Cloudflare go in
#     apps/web/.dev.vars locally. Root .env values reach the web app only if exported in the shell.

# --- Python worker (prefix ARCH_COMPETITION_OPS_, apps/worker/src/arch_competition_ops/settings.py) ---
ARCH_COMPETITION_OPS_ROOT=.
# The one SQLite database path: worker, web local storage (packages/storage) and D1 export tooling.
ARCH_COMPETITION_OPS_DB=data/competitions.sqlite
# ARCH_COMPETITION_OPS_SOURCE_CONFIG=config/sources.yml
# ARCH_COMPETITION_OPS_FILTERS_CONFIG=config/filters.yml
# ARCH_COMPETITION_OPS_TAXONOMY_CONFIG=config/taxonomy.yml
# ARCH_COMPETITION_OPS_BROWSER_STORAGE_DIR=artifacts/crawlee
# ARCH_COMPETITION_OPS_GEOCODE_CACHE=data/geocoding-cache.json
# ARCH_COMPETITION_OPS_HTML_ARCHIVE_DIR=artifacts/html
# ARCH_COMPETITION_OPS_INGEST_LOCK=artifacts/automation/ingest.lock
# ARCH_COMPETITION_OPS_PREVIEW_PREWARM_TIMEOUT_SECONDS=180
# ARCH_COMPETITION_OPS_EXPIRED_COMPETITION_RETENTION_DAYS=7
# ARCH_COMPETITION_OPS_EXPIRED_CLEANUP_STATE=artifacts/automation/expired-competition-cleanup-state.json
# Municipal profile URLs: JSON array, or comma/semicolon/newline separated (collectors/municipal.py).
# ARCH_COMPETITION_OPS_MUNICIPAL_PROFILE_URLS=

# --- OpenAI screening (Python worker only; https://platform.openai.com/api-keys) ---
# Create a project key in the API organization that received the promotional credits.
OPENAI_API_KEY=
# 1 = screen newly ingested opportunities automatically. Manual screen-competitions also works.
ARCH_COMPETITION_OPS_AI_ENABLED=0
ARCH_COMPETITION_OPS_AI_MODEL=gpt-6-luna
# Source extraction and screening use the same call. high is the default reasoning effort.
ARCH_COMPETITION_OPS_AI_REASONING_EFFORT=high
# Luna Decisions API ranks a wider candidate pool before full extraction; unknowns stay eligible.
# ARCH_COMPETITION_OPS_AI_TRIAGE_ENABLED=1
# ARCH_COMPETITION_OPS_AI_CANDIDATE_MULTIPLIER=5
# ARCH_COMPETITION_OPS_AI_TRIAGE_EXCLUDE_THRESHOLD=0.98
ARCH_COMPETITION_OPS_AI_DAILY_BUDGET_USD=1
# Local UTC-day/calendar-month estimated caps across all runs using this database.
# It does not measure the organization's promotional balance or other applications' spending.
ARCH_COMPETITION_OPS_AI_MONTHLY_BUDGET_USD=31
# ARCH_COMPETITION_OPS_AI_PREFERENCES=config/skills/screen-architecture-opportunities/SKILL.md
# ARCH_COMPETITION_OPS_AI_FETCH_DETAILS=1
# ARCH_COMPETITION_OPS_AI_MAX_OUTPUT_TOKENS=12288
# ARCH_COMPETITION_OPS_AI_MAX_INPUT_CHARS=30000
# ARCH_COMPETITION_OPS_AI_TIMEOUT_SECONDS=120

# --- Preview generation, read by the Python worker (settings.py, card_previews.py) ---
# 1 = after each ingest, run the offline preview generator (packages/previews/bin/prewarm.mjs) for
# the new records. Off by default; a failure only warns. It writes artifacts/previews only; use
# `npm run prewarm:previews -w @arch-competition/web` to publish into the Web build.
# ARCH_PREVIEW_PREWARM=
# Node executable used for it (default: node on PATH).
# ARCH_PREVIEW_NODE=
# Directory the generator writes and the Web app reads (default: artifacts/previews).
# ARCH_PREVIEWS_DIR=

# --- Clock override, read by the Python worker only (apps/worker/src/arch_competition_ops/clock.py) ---
# Replay a run as if it were another day (YYYY-MM-DD). Leave unset in normal operation.
# ARCH_COMPETITION_TODAY=

# --- Web app: storage selection (apps/web/src/lib/server-storage.ts) ---
# Use the Cloudflare D1 binding instead of local SQLite while running `next dev` (1 = on).
# ARCH_COMPETITION_USE_D1_IN_DEV=

# --- Web app: accounts and operations access (apps/web/src/lib/auth.ts) ---
# Comma-separated emails of registered users who may open /ops and /api/ops/**.
# On Cloudflare set it as a Worker secret of the same name (see CLOUDFLARE_DEPLOY_RUNBOOK.md). Unset = nobody.
# ARCH_OPS_ADMIN_EMAILS=

# --- Preview generator: packages/previews (offline CLI, never the Web request path) ---
# Contact address sent in the User-Agent of every geocoder/tile request. Nominatim and Photon
# require one; set it before running the generator against them.
ARCH_PREVIEW_CONTACT=
# Geocoding keys are optional; without them the free providers are used.
# Legacy aliases still honoured: BAIDU_MAPS_AK, BAIDU_MAPS_SK, AMAP_MAPS_KEY.
ARCH_SATELLITE_BAIDU_AK=
ARCH_SATELLITE_BAIDU_SK=
ARCH_SATELLITE_AMAP_KEY=
# Endpoint overrides (leave unset for the built-in defaults).
# ARCH_SATELLITE_BAIDU_GEOCODER_URL=
# ARCH_SATELLITE_AMAP_GEOCODER_URL=
# ARCH_SATELLITE_GEOCODER_URL=
# ARCH_SATELLITE_PHOTON_URL=
# ARCH_SATELLITE_TILE_URL_TEMPLATE=
# Credit line drawn on every satellite image; change it together with the tile URL template.
# ARCH_PREVIEW_TILE_ATTRIBUTION=
# Verbose preview logging (1 = on).
# ARCH_SATELLITE_DEBUG=
